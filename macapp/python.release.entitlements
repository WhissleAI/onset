<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The bundled Python in a Developer ID (release) build: every library it loads carries the same team signature, so
     library validation stays ON, and torch / ctypes run without writable-executable memory (verified by the release
     smoke test). Only network: it serves localhost and calls the web search, Deepgram and Anthropic APIs. -->
<plist version="1.0"><dict>
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.network.server</key><true/>
</dict></plist>
